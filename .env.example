# OpenReels API Keys
# Copy this file to .env and fill in your keys
#
# Docker: docker run --env-file .env --shm-size=2gb -v ./output:/output openreels "your topic"
# Local:  pnpm start "your topic"

# Required: LLM provider (at least one)
# Anthropic (default): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI (--provider openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Text-to-Speech (at least one)
# ElevenLabs (default): https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Inworld (--tts-provider inworld): https://inworld.ai/
INWORLD_TTS_API_KEY=

# Required: AI Image Generation (at least one)
# Gemini (default): https://aistudio.google.com/apikey
# OpenAI GPT Image (--image-provider openai): uses OPENAI_API_KEY above
GOOGLE_API_KEY=

# Optional: OpenRouter (--provider openrouter): https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional: Tavily web search (--search-provider tavily): https://tavily.com/
# Required when using OpenRouter/OpenAI-compatible providers for web research
TAVILY_API_KEY=

# Optional: OpenAI-compatible endpoint (--provider openai-compatible)
# OPENREELS_LLM_BASE_URL=http://localhost:11434/v1
# OPENREELS_LLM_MODEL=llama3:8b
# OPENREELS_LLM_API_KEY=

# Optional: 60db cloud provider (LLM + TTS + alignment)
# Adds these CLI flags:
#   --provider 60db
#   --tts-provider 60db        (sync REST /tts-synthesize)
#   --tts-provider 60db-stream (NDJSON /tts-stream)
#   --tts-provider 60db-ws     (realtime WebSocket /ws/tts)
# SIXTYDB_API_KEY=sk_live_...
# SIXTYDB_API_BASE=https://api.60db.ai
# SIXTYDB_LLM_MODEL=60db-tiny
# SIXTYDB_TTS_VOICE_ID=fbb75ed2-975a-40c7-9e06-38e30524a9a1
# Swap local Whisper alignment for 60db /stt (no GPU needed):
# SIXTYDB_USE_CLOUD_ALIGNER=true

# Optional: Stock footage (free, but requires registration)
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
